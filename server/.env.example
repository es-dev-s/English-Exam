PORT=3010
CLIENT_ORIGIN=http://localhost:5173

# Admin portal credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
DATABASE_PATH=./db/exam_portal.db
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Rate limiting (per IP, in-memory — single server instance)
RATE_LIMIT_SUBMIT_WINDOW_MS=900000
RATE_LIMIT_SUBMIT_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10

# Set to true when running behind a reverse proxy (nginx, load balancer)
TRUST_PROXY=false
