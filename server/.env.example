PORT=3010
# Bind on all interfaces so LAN / other hosts can reach the API
HOST=0.0.0.0
# Extra allowed browser origins (comma-separated). Private LAN IPs are allowed automatically.
# Example when frontend is separate: http://localhost:5173,http://192.168.1.10:5173
CLIENT_ORIGIN=http://localhost:5173

# Admin portal credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# PostgreSQL connection (required)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Set to true if the server requires TLS
DATABASE_SSL=false

OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Rate limiting (per IP, in-memory — single server instance)
RATE_LIMIT_SUBMIT_WINDOW_MS=900000
RATE_LIMIT_SUBMIT_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10

# Set to true when running behind a reverse proxy (nginx, load balancer)
TRUST_PROXY=false
