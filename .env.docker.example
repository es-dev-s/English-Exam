# Copy to .env.docker and fill in. Never commit .env.docker.
# NODE_ENV, PORT, HOST, CV_UPLOAD_DIR are set in the Dockerfile; DATABASE_SSL and TRUST_PROXY in docker-compose.yml.

# PostgreSQL (the db service reads POSTGRES_PASSWORD; the api reads DATABASE_URL). Keep the password identical in both.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://exam:<POSTGRES_PASSWORD>@db:5432/exam

# Required in production (server refuses to start without them)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Leave empty for demo (heuristic) grading of written answers; set for real LLM grading
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

RATE_LIMIT_SUBMIT_WINDOW_MS=900000
RATE_LIMIT_SUBMIT_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
