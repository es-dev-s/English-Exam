# Required for separate API host (recommended for deploy):
VITE_API_URL=http://localhost:3010

# Examples:
# VITE_API_URL=http://10.80.80.220:3010
# VITE_API_URL=http://192.168.0.103:3010

# Leave unset to auto-use same page hostname + port 3010.
# Same-origin reverse proxy:
# VITE_API_URL=
